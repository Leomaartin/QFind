generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // change if needed
  url      = env("DATABASE_URL")
}

model Country {
  id        Int      @id @default(autoincrement())
  name      String
  label     String
  archived  Boolean

  states    State[]
  services  Service[]
}

model State {
  id        Int      @id @default(autoincrement())
  name      String
  label     String
  active    Boolean

  countryId Int
  country   Country  @relation(fields: [countryId], references: [id])

  cities    City[]
  services  Service[]
}

model City {
  id       Int    @id @default(autoincrement())
  name     String
  label    String

  stateId  Int
  state    State  @relation(fields: [stateId], references: [id])

  services Service[]
}

model Category {
  id          Int      @id @default(autoincrement())
  label       String
  description String
  active      Boolean

  subcategories Subcategory[]
  services      Service[]
}

model Subcategory {
  id          Int      @id @default(autoincrement())
  name        String
  label       String
  description String
  active      Boolean

  categoryId  Int
  category    Category @relation(fields: [categoryId], references: [id])

  services    Service[]
}

model Service {
  id             Int     @id @default(autoincrement())
  name           String
  label          String
  description    String
  phone          String
  instagram      String?
  email          String?
  image          String?
  active         Boolean
  validated      Boolean
  paid           Boolean

  categoryId     Int
  subcategoryId  Int
  stateId        Int
  countryId      Int
  cityId         Int

  category       Category    @relation(fields: [categoryId], references: [id])
  subcategory    Subcategory @relation(fields: [subcategoryId], references: [id])
  state          State       @relation(fields: [stateId], references: [id])
  country        Country     @relation(fields: [countryId], references: [id])
  city           City        @relation(fields: [cityId], references: [id])

  plans          Plan[]
}

model Plan {
  id          Int      @id @default(autoincrement())
  name        String
  label       String
  duration    Int
  startDate   DateTime
  endDate     DateTime
  paymentStatus Boolean

  serviceId   Int
  service     Service @relation(fields: [serviceId], references: [id])
}